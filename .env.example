# Copy to .env.local and fill in. All values below are placeholders.

# Public base URL of the deployed app (used for the Telegram webhook and login redirects; must be https)
APP_URL=https://your-app.example.com

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.example
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, never prefix with NEXT_PUBLIC_

# Single-user app: only this email may sign in
OWNER_EMAIL=demo@example.com
# The owner's user id from Supabase > Authentication > Users (used by webhook/cron writes)
OWNER_USER_ID=00000000-0000-0000-0000-000000000000

# Telegram bot (from BotFather)
TELEGRAM_BOT_TOKEN=replace-with-bot-token
TELEGRAM_WEBHOOK_SECRET=replace-with-long-random-string   # sent by Telegram as x-telegram-bot-api-secret-token
# The bot only answers this chat (linked from Settings after sending /start)
TELEGRAM_CHAT_ID=

# Receipt OCR: Google AI Studio key (free tier may use submitted content to improve Google products)
GEMINI_API_KEY=replace-with-gemini-key
GEMINI_MODEL=                     # optional, default gemini-flash-latest
GEMINI_FALLBACK_MODELS=           # optional, comma separated; default gemini-flash-lite-latest (tried on 503/429)

# Alternative/fallback OCR: Groq (images only)
GROQ_API_KEY=
GROQ_MODEL=                       # optional
RECEIPT_PROVIDER=                 # optional: auto (default, Gemini first) | gemini | groq

# Email notifications and login codes (Resend). Without it, login falls back to Supabase email OTP.
RESEND_API_KEY=
NOTIFY_FROM=Panel <onboarding@resend.dev>

# Bearer token for Apple Pay Shortcut / Gmail bridge webhooks (/api/ingest/*)
INGEST_SECRET=replace-with-long-random-string
# Bearer token Vercel Cron sends to /api/cron/*
CRON_SECRET=replace-with-long-random-string

# Optional
APP_TZ=Europe/Berlin
# FX_API_URL=, OFF_API_BASE=, GEMINI_API_BASE=, GROQ_API_BASE=, TELEGRAM_API_BASE=, RESEND_API_URL=  (override upstream APIs, e.g. for tests)
